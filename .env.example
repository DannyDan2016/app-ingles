# Local: Postgres de docker-compose. En Vercel se usa la URL pooled de Neon (variable de entorno, nunca en el repo).
DATABASE_URL=postgres://app:app_local_only@localhost:5432/app_ingles
DATABASE_URL_TEST=postgres://app:app_local_only@localhost:5432/app_ingles_test
# Solo para el stack E2E local por http. Prohibido en Vercel.
COOKIE_INSECURE=false
